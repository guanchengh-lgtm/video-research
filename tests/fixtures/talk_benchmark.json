    "segments": [
      {"start_ms": 0, "end_ms": 30000, "text": "Today I want to walk through how we moved the ingest pipeline.", "speaker_label": "S1"},
      {"start_ms": 30000, "end_ms": 95000, "text": "There are three steps: drain the queue, dual-write, then cut over reads.", "speaker_label": "S1"},
