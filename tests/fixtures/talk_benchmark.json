      {"start_ms": 120000, "end_ms": 210000, "text": "The dual-write phase is where most teams get into trouble.", "speaker_label": "S1"},
      {"start_ms": 210000, "end_ms": 240000, "text": "Correction on the earlier number, it was six thousand events per second, not nine.", "speaker_label": "S1"},
      {"start_ms": 240000, "end_ms": 450000, "text": "Let me show you the dashboard during the cutover window.", "speaker_label": "S1"},
      {"start_ms": 450000, "end_ms": 520000, "text": "Here are the numbers we ended up with.", "speaker_label": "S1"},
      {"start_ms": 520000, "end_ms": 560000, "text": "On the sample workload this came out at four point two times faster.", "speaker_label": "S1"},
      {"start_ms": 560000, "end_ms": 598000, "text": "That is the whole migration. Questions are in the thread.", "speaker_label": "S1"}
    ]
